# =====================================================================
# Bluezone Habitat Daily Accounts — Google Sheets & Cloud Configuration
# =====================================================================

# 1. Google Spreadsheet ID
# From your browser URL: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID_HERE/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# 2. Google Service Account Email
# Generated in Google Cloud Console -> IAM & Admin -> Service Accounts
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com

# 3. Google Service Account Private Key
# Copied from the downloaded credentials JSON file ("private_key").
# Keep the quotes and the \n line breaks intact:
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
